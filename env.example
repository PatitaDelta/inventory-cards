# Copia este archivo a ".env" y cambia los valores. El archivo .env NO se sube al repositorio.

# Contraseña de MySQL (la usan el contenedor de MySQL y la app)
DB_PASSWORD=cambia_esto

# Contraseña para entrar a la web (mínimo 8 caracteres)
APP_PASSWORD=cambia_esto_tambien

# Opcional: texto largo y aleatorio para que la sesión sobreviva a reinicios del servidor
# SESSION_SECRET=

# Solo si ejecutas sin Docker (npm start); estos son los valores por defecto:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_NAME=inventario_ygo
# PORT=3000

# Solo para desplegar en un servidor (perfil "prod"):
# DOMAIN=inventario.tudominio.com
# TRUST_PROXY=1
